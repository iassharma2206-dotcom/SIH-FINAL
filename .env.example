# QRoute23 Environment Configuration Example
# Copy this file to .env and set your API keys as needed.

# TomTom API Key for high-accuracy road routing
# IMPORTANT: Never commit actual secret keys to version control.
TOMTOM_API_KEY=your_tomtom_api_key_here

# Optional: Custom Basemap Tile API Key (e.g. Stadia Maps, MapTiler, CARTO)
MAP_TILE_API_KEY=your_tile_api_key_here
